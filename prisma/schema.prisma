// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  CASA              // House
  DEPARTAMENTO      // Apartment
  TERRENO           // Land
  LOCAL_COMERCIAL   // Commercial Space
  OFICINA           // Office
  BODEGA            // Warehouse
  RANCHO            // Ranch
}

enum PropertyStatus {
  VENTA             // For Sale
  RENTA             // For Rent
  VENDIDO           // Sold
  RENTADO           // Rented
}

enum UserRole {
  USER
  AGENT
  ADMIN
}

// Profile extends Supabase Auth user data
model Profile {
  id            String    @id // This is the Supabase Auth user ID
  email         String    @unique
  name          String?
  phone         String?
  role          UserRole  @default(USER)
  avatarUrl     String?
  sellerType    String?   // PARTICULAR, INMOBILIARIA, CORREDOR

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  properties          Property[]
  favorites           Favorite[]
  savedSearches       SavedSearch[]
  inquiriesSent       Inquiry[]       @relation("InquirySender")
  buyerConversations  Conversation[]  @relation("BuyerConversations")
  sellerConversations Conversation[]  @relation("SellerConversations")
  messagesSent        Message[]       @relation("MessagesSent")

  @@index([email])
}

model Property {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text

  // Property Details
  type          PropertyType
  status        PropertyStatus
  price         Decimal         @db.Decimal(12, 2)
  bedrooms      Int?
  bathrooms     Decimal?        @db.Decimal(3, 1) // 2.5 bathrooms
  parkingSpaces Int?
  areaTotal     Decimal?        @db.Decimal(10, 2) // m²
  areaCovered   Decimal?        @db.Decimal(10, 2) // m²
  yearBuilt     Int?

  // Mexican Address
  street        String
  exteriorNumber String?
  interiorNumber String?
  colonia       String         // Neighborhood
  municipality  String         // Municipio
  state         String         // Estado
  postalCode    String
  country       String         @default("México")

  // Location
  latitude      Decimal?       @db.Decimal(10, 8)
  longitude     Decimal?       @db.Decimal(11, 8)

  // Features (JSON for flexibility)
  amenities     Json?          // {pool: true, gym: true, etc}

  // Media
  images        PropertyImage[]
  mainImageUrl  String?

  // SEO
  slug          String         @unique

  // Metadata
  featured      Boolean        @default(false)
  active        Boolean        @default(true)
  views         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  publishedAt   DateTime?

  // Relations
  ownerId       String
  owner         Profile        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites     Favorite[]
  inquiries     Inquiry[]
  conversations Conversation[]

  @@index([type, status, state, municipality])
  @@index([price, bedrooms, bathrooms])
  @@index([latitude, longitude])
  @@index([slug])
  @@index([ownerId])
  @@index([createdAt])
}

model PropertyImage {
  id          String   @id @default(cuid())
  url         String
  alt         String?
  order       Int      @default(0)

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([propertyId, order])
}

model Favorite {
  id          String   @id @default(cuid())

  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model SavedSearch {
  id          String   @id @default(cuid())
  name        String

  // Search Criteria (JSON)
  criteria    Json     // {type, minPrice, maxPrice, bedrooms, state, etc}

  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Inquiry {
  id          String   @id @default(cuid())

  name        String
  email       String
  phone       String?
  message     String   @db.Text

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  senderId    String?
  sender      Profile? @relation("InquirySender", fields: [senderId], references: [id], onDelete: SetNull)

  status      String   @default("NUEVO") // NUEVO, CONTACTADO, CERRADO

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([senderId])
  @@index([createdAt])
}

// Conversation between two users about a property
model Conversation {
  id              String    @id @default(cuid())

  // Property context (required)
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Participants
  buyerId         String    // User inquiring about property
  buyer           Profile   @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String    // Property owner
  seller          Profile   @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)

  // Metadata
  lastMessageAt   DateTime?
  lastMessageText String?   @db.VarChar(100)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  messages        Message[]

  @@unique([propertyId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
}

// Individual messages within a conversation
model Message {
  id              String       @id @default(cuid())

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId        String
  sender          Profile      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  content         String       @db.Text

  // Read tracking
  readAt          DateTime?

  createdAt       DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}
